{
  "name": "spaces",
  "version": "1.0.0",
  "description": "Free web ide for teens",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "client-install": "cd client && npm install",
    "test": "node --test",
    "start": "node src/index.js",
    "serve:server": "nodemon src/index.js",
    "serve:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run serve:server\" \"npm run serve:client\"",
    "migrate": "knex migrate:latest",
    "create-fake-user": "node create_user_dev.js"
  },
  "author": "Charmunk",
  "license": "MIT",
  "dependencies": {
    "@vercel/sandbox": "^3.9.1",
    "airtable": "^0.12.2",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "knex": "^3.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "qs": "^6.16.1",
    "nodemon": {
      "minimatch": "^11.0.1"
    },
    "@vercel/cli-config": {
      "zod": "^4.6.6"
    }
  }
}
