# Copy to /root/.spaces-backup.env on the Spaces host and chmod 600.
# Contains a database password — keep it root-only.

# Same value as the app's PG_CONNECTION_STRING.
# Read it from the running app container:
#   docker exec $(docker ps --format={{.Names}} | grep spaces-app) printenv PG_CONNECTION_STRING
PG_CONNECTION_STRING=

# Storage Box account, e.g. u666378@u666378.your-storagebox.de
SB_HOST=

# Where user files live on this host.
VOLUME_BASE_PATH=/data

# How many days of database dumps to keep.
DB_RETENTION_DAYS=30

# SSH key used to reach the Storage Box.
SSH_KEY=/root/.ssh/id_ed25519
