{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["arn1"],
  "services": {
    "app": {
      "root": ".",
      "framework": "express",
      "buildCommand": "npm run migrate"
    },
    "client": {
      "root": "client",
      "framework": "vite",
      "rewrites": [
        { "source": "/godot/", "destination": "/godot/index.html" },
        { "source": "/((?!godot/).*)", "destination": "/index.html" }
      ]
    }
  },
  "crons": [
    { "path": "/api/v1/cron/auto-stop", "schedule": "*/5 * * * *" }
  ],
  "redirects": [
    { "source": "/godot", "destination": "/godot/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/godot/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "app" } },
    { "source": "/(.*)", "destination": { "service": "client" } }
  ]
}
