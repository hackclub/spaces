{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "regions": ["arn1"],
  "crons": [
    { "path": "/api/v1/cron/auto-stop", "schedule": "*/5 * * * *" }
  ],
  "redirects": [
    { "source": "/godot", "destination": "/godot/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/godot/", "destination": "/godot/index.html" },
    { "source": "/((?!api/|godot/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/godot/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
