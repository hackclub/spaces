{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["arn1"],
  "services": {
    "app": {
      "root": ".",
      "framework": "express",
      "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then npm run migrate; fi"
    },
    "client": {
      "root": "client",
      "framework": "vite",
      "rewrites": [
        { "source": "/godot/", "destination": "/godot/index.html" },
        { "source": "/love/", "destination": "/love/index.html" },
        { "source": "/((?!godot/|love/).*)", "destination": "/index.html" }
      ]
    }
  },
  "crons": [
    { "path": "/api/v1/cron/auto-stop", "schedule": "*/5 * * * *" },
    { "path": "/api/v1/cron/templates", "schedule": "0 4 * * *" }
  ],
  "redirects": [
    { "source": "/godot", "destination": "https://spaces-playground.hackclub.dev/godot/", "permanent": false },
    {
      "source": "/godot/:path((?!service\\.worker\\.js$).*)",
      "missing": [{ "type": "host", "value": "spaces-playground.hackclub.dev" }],
      "destination": "https://spaces-playground.hackclub.dev/godot/:path",
      "permanent": false
    },
    {
      "source": "/love/:path*",
      "missing": [{ "type": "host", "value": "spaces-playground.hackclub.dev" }],
      "destination": "https://spaces-playground.hackclub.dev/love/:path*",
      "permanent": false
    },
    { "source": "/love", "destination": "https://spaces-playground.hackclub.dev/love/", "permanent": false },
    {
      "source": "/((?!love/|godot/|_vercel/).*)",
      "has": [{ "type": "host", "value": "spaces-playground.hackclub.dev" }],
      "destination": "https://spaces.hackclub.com/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/godot/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "app" } },
    { "source": "/(.*)", "destination": { "service": "client" } }
  ]
}
